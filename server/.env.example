NODE_ENV=development
PORT=4100
# Optional: serve the built UI from Node as well (otherwise IIS serves client/dist - see docs/DEPLOYMENT-IIS.md)
# CLIENT_DIR=../client/dist
# Public URL of the React app; used to build links in emails
APP_BASE_URL=http://localhost:5173
# Set to the number of proxies in front of Node (1 behind IIS/ARR) so req.ip is the real client
TRUST_PROXY=0

# --- Database ---
# windows = Trusted_Connection via ODBC (msnodesqlv8); sql = SQL login via tedious
DB_AUTH=windows
DB_SERVER=.\SQLEXPRESS
DB_NAME=ApprovalFlow
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# only for DB_AUTH=sql
DB_USER=
DB_PASSWORD=

# --- Auth ---
# at least 32 chars; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=14
# true in production (HTTPS)
COOKIE_SECURE=false

# --- Accounts ---
# Users create their own 6-digit password key at first sign-in. A one-time code is emailed to prove the address is theirs.
FIRST_LOGIN_EMAIL_VERIFICATION=true
# Only these domains may self-register (comma separated). Empty = anyone.
ALLOWED_EMAIL_DOMAINS=

# --- Email --- leave SMTP_HOST empty to write .eml files to STORAGE_DIR/mail instead of sending
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Approvals <no-reply@example.com>
STORAGE_DIR=./storage
# PDF manuals shown by Help in the app, to signed-in people only (built by docs/manuals/build-manuals.cjs)
# MANUALS_DIR=../docs/manuals

# --- Tenant addressing (multi-customer) ---
# Base domain for customer sub-sites: each customer is reached at <slug>.<APP_DOMAIN>
# (or at its own Tenants.Host). Leave empty for a single-customer deployment.
APP_DOMAIN=
# Host of the global management site, if it is served from this API.
PLATFORM_HOST=
# Fallback for addresses that name no customer (e.g. plain http://localhost).
# Only needed once the database holds more than one customer.
TENANT_SLUG=
# Days a removed customer is kept (restorable from the global console) before its data is deleted for good.
TENANT_REMOVAL_DAYS=30
